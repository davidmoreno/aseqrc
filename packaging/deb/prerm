#!/bin/sh
# prerm script for aseqrc
set -e

case "$1" in
	remove|deconfigure)
		if [ -d /run/systemd/system ]; then
			systemctl --system stop aseqrc.service >/dev/null 2>&1 || true
		fi
		;;

	upgrade|failed-upgrade)
		;;

	*)
		echo "prerm called with unknown argument \`$1'" >&2
		exit 1
		;;
esac

exit 0
